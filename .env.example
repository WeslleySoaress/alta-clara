# Modelo. Não preencha à mão: rode `npm run setup`, que gera DOIS arquivos
# com valores aleatórios (nenhum é versionado):

# ── .env.local — aplicação web e processador de lembretes ──
BETTER_AUTH_SECRET=...
BETTER_AUTH_URL=...
DATABASE_URL=...            # usuário alta_app (sem DDL, auditoria só insere)
# Opcional: proxies confiáveis para o IP do cliente (produção)
ALTA_PROXIES_CONFIAVEIS=...
# Opcional: recusar senhas vazadas via Pwned Passwords (k-anonimato; só 5 caracteres do SHA-1 saem)
ALTA_SENHAS_VAZADAS=...       # "hibp" para ligar
# Opcional: IA para a equipe (desligada por padrão; só com dados sintéticos)
ALTA_IA_HABILITADA=...
ANTHROPIC_API_KEY=...

# ── .env.operacao.local — banco, migrações, seed, backup e testes ──
# A aplicação web NÃO lê este arquivo (e recusa subir em produção com estes valores).
PG_PORT=...
PG_SUPERUSER_PASSWORD=...
DB_OWNER_PASSWORD=...
DB_APP_PASSWORD=...
DATABASE_URL_OWNER=...
ALTA_BACKUP_KEY=...         # gerada por scripts/backup.ts se ausente
