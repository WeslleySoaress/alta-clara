{
  "name": "alta-clara",
  "version": "0.1.0",
  "private": true,
  "description": "Orientação e acompanhamento da alta hospitalar — projeto de portfólio com dados fictícios.",
  "author": "Weslley Soares (https://github.com/WeslleySoaress)",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "setup": "tsx scripts/setup-env.ts",
    "db": "tsx scripts/db.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e.ts",
    "test:dast": "tsx scripts/dast.ts",
    "check:contraste": "tsx scripts/contraste.ts",
    "check:sast": "eslint -c eslint.security.config.mjs src scripts",
    "check:segredos": "secretlint \"**/*\"",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "capturas": "tsx scripts/capturas.ts",
    "lembretes": "tsx scripts/lembretes.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@better-auth/passkey": "^1.7.7",
    "@node-rs/argon2": "^2.2.1",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.13.0",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-security": "^4.2.0",
    "jsqr": "^1.4.0",
    "pg-copy-streams": "^7.0.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "secretlint": "^13.0.7",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
